{
  "name": "jaclyn-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro check && astro build",
    "preview": "wrangler types && astro preview",
    "db:seed:generate": "node scripts/generate_d1_seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply jaclyn-osborn-catalog --local",
    "db:migrate": "wrangler d1 migrations apply jaclyn-osborn-catalog --remote",
    "db:seed:local": "wrangler d1 execute jaclyn-osborn-catalog --local --file seeds/catalog.sql",
    "db:seed": "wrangler d1 execute jaclyn-osborn-catalog --remote --file seeds/catalog.sql",
    "images:optimize": "node scripts/optimize-images.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.4.2",
    "jose": "^6.2.13",
    "tailwindcss": "^4.2.2",
    "wrangler": "^4.79.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@types/node": "^25.5.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
