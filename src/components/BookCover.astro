---
import type { Book } from '../types/catalog';
import { resolveCoverAlt, resolveCoverImagePath } from '../lib/catalog/covers';
import optimized from '../data/optimized-images.json';
interface Props {
  book: Book;
  className?: string;
  priority?: boolean;
}
const { book, className = '', priority = false } = Astro.props;
const src = resolveCoverImagePath(book);
const variants = (optimized as Record<string, string>)[src];
---

<div class:list={['book-cover', className]}>
  <span class="cover-fallback" aria-hidden="true">
    {book.title}
    <small>Jaclyn Osborn</small>
  </span>
  <picture>
    {variants && (
      <source
        type="image/webp"
        srcset={variants}
        sizes="(max-width: 600px) 45vw, 320px"
      />
    )}
    <img
      src={src}
      alt={resolveCoverAlt(book)}
      width="600"
      height="900"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding="async"
      onerror="this.style.visibility='hidden'"
    />
  </picture>
</div>
