---
interface Props {
  compact?: boolean;
}
const c = Astro.locals.content;
---

<section class="newsletter-panel">
  <div>
    <p class="eyebrow">Letters from Jaclyn</p>
    <h2>{c.newsletterTitle}</h2>
  </div>
  <div>
    <p>{c.newsletterCopy}</p>
    {c.newsletterUrl ? (
      <a class="button-primary" href={c.newsletterUrl}>
        Join the newsletter <span aria-hidden="true">↗</span>
      </a>
    ) : (
      <>
        <a
          class="button-primary"
          href={`mailto:${c.email}?subject=Newsletter%20enquiry`}
        >
          Ask about the newsletter <span aria-hidden="true">↗</span>
        </a>
        <small>
          Opens your email app. This does not subscribe you automatically.
        </small>
      </>
    )}
  </div>
</section>
