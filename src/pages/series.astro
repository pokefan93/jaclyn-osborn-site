---
import BookCard from '../components/BookCard.astro';
import PageHero from '../components/PageHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicCatalogData } from '../lib/catalog/repository';
const { booksBySeries } = await getPublicCatalogData();
const c = Astro.locals.content;
---

<BaseLayout
  title="Series & reading order"
  description="Explore Jaclyn Osborn’s M/M romance series, with every book in reading order."
>
  <PageHero
    eyebrow="The reading guide"
    title={c.seriesTitle}
    description={c.seriesCopy}
    compact
  />
  <nav class="editorial-width series-index" aria-label="Jump to series">
    {booksBySeries.map((s) => (
      <a href={`#${s.slug}`}>
        {s.name} <span aria-hidden="true">↓</span>
      </a>
    ))}
  </nav>
  <div class="editorial-width">
    {booksBySeries.map((s, index) => (
      <section id={s.slug} class="series-chapter">
        <div class="series-intro">
          <p class="eyebrow">
            {String(index + 1).padStart(2, '0')} / {s.lane}
          </p>
          <h2>{s.name}</h2>
          <p>{s.description}</p>
          <p class="series-start">
            Start with {s.entryPoint || s.books[0]?.title}
          </p>
        </div>
        <div class="series-books">
          {s.books.map((book) => (
            <BookCard book={book} showSeries={false} showOrder />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
