---
import BookCover from '../components/BookCover.astro';
import NewsletterPanel from '../components/NewsletterPanel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicCatalogData } from '../lib/catalog/repository';
const { books, booksBySeries } = await getPublicCatalogData();
const c = Astro.locals.content;
const featured =
  books.find((b) => b.slug === c.featuredBookSlug) ??
  books.find((b) => b.featured) ??
  books[0];
const discoveries = booksBySeries
  .filter((s) => s.slug !== 'standalones')
  .slice(0, 4);
---

<BaseLayout>
  {c.announcement && (
    <aside class="announcement">
      {c.announcementUrl ? (
        <a href={c.announcementUrl}>
          {c.announcement} <span aria-hidden="true">↗</span>
        </a>
      ) : (
        c.announcement
      )}
    </aside>
  )}
  <section class="home-hero editorial-width">
    <div class="hero-copy">
      <p class="eyebrow">The stories of Jaclyn Osborn</p>
      <h1>{c.heroTitle}</h1>
      <p class="hero-intro">{c.heroCopy}</p>
      <div class="hero-actions">
        <a class="button-primary" href="/books/">
          Find your next read <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/series/">
          Explore the series
        </a>
      </div>
      <p class="hero-footnote">
        M/M ROMANCE <span aria-hidden="true">—</span> CONTEMPORARY · FANTASY ·
        PARANORMAL · HISTORICAL
      </p>
    </div>
    {featured && (
      <div class="featured-book">
        <div class="feature-frame">
          <span class="feature-index" aria-hidden="true">
            JO / THE BOOKSHELF
          </span>
          <a
            href={`/books/${featured.slug}/`}
            aria-label={`Discover ${featured.title}`}
          >
            <BookCover book={featured} priority />
          </a>
          <span class="feature-caption">A world to get lost in.</span>
        </div>
        <div class="feature-credit">
          <div>
            <p class="eyebrow">On the bookshelf</p>
            <h2>
              <a href={`/books/${featured.slug}/`}>{featured.title}</a>
            </h2>
          </div>
          <a
            href={`/books/${featured.slug}/`}
            class="round-link"
            aria-label={`Read about ${featured.title}`}
          >
            ↗
          </a>
        </div>
      </div>
    )}
  </section>
  <section class="discovery-section editorial-width">
    <div class="section-masthead">
      <div>
        <p class="eyebrow">One author. Many worlds.</p>
        <h2>{c.discoverTitle}</h2>
      </div>
      <a class="text-link" href="/series/">
        All series <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="discovery-grid">
      {discoveries.map((series, index) => (
        <a class="discovery-item" href={`/series/#${series.slug}`}>
          <div class="discovery-cover">
            <BookCover book={series.books[0]} />
            <span class="discovery-number" aria-hidden="true">
              0{index + 1}
            </span>
          </div>
          <p class="eyebrow">{series.lane || 'M/M romance'}</p>
          <h3>
            {series.name} <span aria-hidden="true">↗</span>
          </h3>
          <p>
            {series.books.length} {series.books.length === 1 ? 'book' : 'books'}{' '}
            · Explore the reading order
          </p>
        </a>
      ))}
    </div>
  </section>
  <section class="author-section editorial-width">
    <div class="author-portrait">
      <img
        src={c.authorPhoto}
        alt={c.name}
        width="480"
        height="600"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div>
      <p class="eyebrow">Hello, I’m Jaclyn.</p>
      <h2>{c.authorTitle}</h2>
      <p class="author-bio">{c.longBio}</p>
      <a class="text-link" href="/about/">
        A little more about me <span aria-hidden="true">↗</span>
      </a>
      <p class="author-signature">{c.name}</p>
    </div>
  </section>
  <div class="editorial-width newsletter-wrap">
    <NewsletterPanel />
  </div>
</BaseLayout>
