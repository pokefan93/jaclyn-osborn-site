---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterPanel from '../components/NewsletterPanel.astro';
const c = Astro.locals.content;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: c.name,
    description: c.longBio,
    image: new URL(c.authorPhoto, Astro.site).href,
    sameAs: c.instagramUrl ? [c.instagramUrl] : [],
  },
};
---

<BaseLayout
  title="About Jaclyn Osborn"
  description={c.longBio.slice(0, 280)}
  structuredData={schema}
>
  <section class="author-section editorial-width" style="border-top:0">
    <div class="author-portrait">
      <img
        src={c.authorPhoto}
        alt={c.name}
        width="480"
        height="600"
        fetchpriority="high"
      />
    </div>
    <div>
      <p class="eyebrow">{c.shortTagline}</p>
      <h1 style="font-size:clamp(3rem,5vw,5rem);line-height:1.1;margin-top:20px">
        {c.aboutTitle}
      </h1>
      <p class="author-bio">{c.longBio}</p>
      <div class="hero-actions">
        <a class="button-primary" href="/books/">
          Explore the books ↗
        </a>
        <a class="text-link" href="/contact/">
          Get in touch
        </a>
      </div>
    </div>
  </section>
  <div class="editorial-width">
    <NewsletterPanel />
  </div>
</BaseLayout>
